# ==============================================================================
# Digital Pastor ("Pastor Mike") — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Recommended for Cloud / High-Quality LLM Responses)
# ------------------------------------------------------------------------------
# Get your free Google Gemini API key at: https://aistudio.google.com/app/apikey
# When configured, Pastor Mike uses Google Gemini to generate deeply empathetic,
# scripture-aware pastoral counsel and bespoke prayers.
# If omitted or unconfigured, Pastor Mike automatically falls back to local Ollama
# or the built-in offline pastoral engine (zero external API keys required).
GEMINI_API_KEY=
# Alternative variable names supported:
# GOOGLE_API_KEY=
# GOOGLE_GENAI_API_KEY=
# Optional: Model name (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Local Ollama LLM Configuration (Optional Open-Source LLM)
# ------------------------------------------------------------------------------
# If you run Ollama locally (e.g. ollama run llama3.2):
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 3. Server & Database Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Database Storage Location (Defaults to ./data/pastor_mike.db)
# SQLITE_DB_PATH=./data/pastor_mike.db

# ------------------------------------------------------------------------------
# 4. Voice & Speech Synthesis Configuration (Optional)
# ------------------------------------------------------------------------------
# Presets: Bella, Jasper, Luna, Bruno, Rosie, Hugo, Kiki, Leo
DEFAULT_VOICE_PRESET=Jasper
DEFAULT_SPEECH_SPEED=0.88
