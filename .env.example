# ==============================================================================
# Digital Pastor ("Pastor Mike") — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local overrides:
#   cp .env.example .env.local
#
# Note: Pastor Mike is 100% private and local-first.
# NO external cloud API keys (OpenAI, Anthropic, ElevenLabs) are required.
# All variables below are optional and pre-configured with sensible defaults.
# ==============================================================================

# Server Port & Node Environment
PORT=3000
NODE_ENV=development

# Database Storage Location (Defaults to ./data/pastor_mike.db)
# SQLITE_DB_PATH=./data/pastor_mike.db

# Local Ollama LLM Configuration (Optional)
# If Ollama is running locally, Pastor Mike can query your local model.
# If unavailable or unconfigured, Pastor Mike uses the built-in offline pastoral engine.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Voice & Speech Synthesis Configuration (Optional)
# Default voice preset for KittenTTS voice pipeline:
# Available presets: Jasper, Bella, Leo, Luna, Bruno, Rosie, Hugo, Cleo
DEFAULT_VOICE_PRESET=Jasper
DEFAULT_SPEECH_SPEED=0.88

# Model Context Protocol (MCP) Configuration (Optional)
MCP_SERVER_NAME=pastor-mike-mcp
MCP_SERVER_VERSION=1.0.0
